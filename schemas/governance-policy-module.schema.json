{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://govai.dev/schemas/governance-policy-module.schema.json",
  "title": "GovAI Governance Policy Module",
  "description": "Structural schema for govai.standards.governance_policy_module.v1 documents. Mirrors python/aigov_py/standards/policy_module.py, the authoritative Python validator; that validator remains the source of truth in case of any discrepancy.",
  "type": "object",
  "required": ["schema_version", "policy", "requirements"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "govai.standards.governance_policy_module.v1"
    },
    "policy": {
      "type": "object",
      "required": ["id", "name", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "required_evidence"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "required_evidence": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
